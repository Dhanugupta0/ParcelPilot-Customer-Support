# Key from https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# The model only writes prose. Every figure it is given is already computed.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium

# Jina Embeddings API key for policy vector store.
# Get one at https://jina.ai/embeddings/
JINA_EMBED_MODEL=jina_your_api_key_here
